# Supabase credentials (Project Settings -> API).
#
# 1. Copy this file to `.env` (which is git-ignored).
# 2. Paste your project's values below.
#
# Only variables prefixed with VITE_ are exposed to the browser. The anon key is
# a publishable key that is safe to ship; access to data is enforced by row
# level security on the Supabase project.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripe (test mode only). Set these in Vercel -> Settings -> Environment
# Variables; they are read by the serverless functions in /api.
# STRIPE_SECRET_KEY must be a test key (sk_test_...); live keys are refused.
# VITE_STRIPE_PUBLISHABLE_KEY is optional: checkout redirects to Stripe's hosted
# page, so the browser does not need Stripe.js.
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=

# Server-only (Vercel functions in /api): reads the private "source-files"
# bucket and the catalogue tables. Never prefix with VITE_ (that would expose it).
# Locally, put it in .env.local (git-ignored).
SUPABASE_SERVICE_ROLE_KEY=
